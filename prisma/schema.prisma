generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model BusinessProfile {
  id              String   @id @default("singleton")
  logoDataUrl     String?
  name            String   @default("")
  ssmNumber       String   @default("")
  address         String   @default("")
  phone           String   @default("")
  email           String   @default("")
  bankDetailsText String   @default("")
  updatedAt       DateTime @updatedAt
}

model QuotationTermsTemplate {
  id        String   @id @default(cuid())
  name      String
  text      String   @default("")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations Quotation[]
}

model Client {
  id            String   @id @default(cuid())
  name          String
  address       String
  contactPerson String?
  phone         String?
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quotations     Quotation[]
  deliveryOrders DeliveryOrder[]
  invoices       Invoice[]
}

model Item {
  id               String   @id @default(cuid())
  name             String
  description      String?
  unit             String
  defaultUnitPrice Decimal  @db.Decimal(12, 2)
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  quotationLines     QuotationLineItem[]
  deliveryOrderLines DeliveryOrderLineItem[]
  invoiceLines       InvoiceLineItem[]
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  VOIDED
}

enum DeliveryOrderStatus {
  DRAFT
  DELIVERED
  VOIDED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  VOIDED
}

enum DocType {
  QUOTATION
  DELIVERY_ORDER
  INVOICE
  DEPOSIT_INVOICE
  RECEIPT
}

model Quotation {
  id        String          @id @default(cuid())
  number    String?         @unique
  year      Int?
  date      DateTime        @default(now())
  clientId  String
  client    Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title     String?
  notes     String?
  status    QuotationStatus @default(DRAFT)
  termsTemplateId String?
  termsTemplate   QuotationTermsTemplate? @relation(fields: [termsTemplateId], references: [id], onDelete: SetNull)
  termsText String?
  issuedAt  DateTime?
  acceptedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  lineItems      QuotationLineItem[]
  costs          QuotationCost[]
  deliveryOrder  DeliveryOrder?
  depositInvoice DepositInvoice?
}

model QuotationLineItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  description String
  quantity    Decimal   @db.Decimal(12, 2)
  unitPrice   Decimal   @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(12, 2)
  sortOrder   Int       @default(0)
}

model QuotationCost {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  label       String
  amount      Decimal   @db.Decimal(12, 2)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DeliveryOrder {
  id                String              @id @default(cuid())
  number            String?             @unique
  year              Int?
  date              DateTime            @default(now())
  clientId          String
  client            Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title             String?
  notes             String?
  status            DeliveryOrderStatus @default(DRAFT)
  sourceQuotationId String?             @unique
  sourceQuotation   Quotation?          @relation(fields: [sourceQuotationId], references: [id])
  issuedAt          DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  lineItems DeliveryOrderLineItem[]
  invoice   Invoice?
}

model DepositInvoice {
  id                String     @id @default(cuid())
  number            String?    @unique
  year              Int?
  date              DateTime   @default(now())
  amount            Decimal    @db.Decimal(12, 2)
  sourceQuotationId String?    @unique
  sourceQuotation   Quotation? @relation(fields: [sourceQuotationId], references: [id])
  issuedAt          DateTime?
  receivedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  receipt Receipt?
}

model DeliveryOrderLineItem {
  id              String        @id @default(cuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  description     String
  quantity        Decimal       @db.Decimal(12, 2)
  unitPrice       Decimal       @db.Decimal(12, 2)
  lineTotal       Decimal       @db.Decimal(12, 2)
  sortOrder       Int           @default(0)
}

model Invoice {
  id                    String         @id @default(cuid())
  number                String?        @unique
  year                  Int?
  date                  DateTime       @default(now())
  clientId              String
  client                Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title                 String?
  notes                 String?
  status                InvoiceStatus  @default(DRAFT)
  sourceDeliveryOrderId String?        @unique
  sourceDeliveryOrder   DeliveryOrder? @relation(fields: [sourceDeliveryOrderId], references: [id])
  bankDetailsText       String?
  depositReceived       Decimal?       @db.Decimal(12, 2)
  depositReceivedAt     DateTime?
  issuedAt              DateTime?
  paidAt                DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  lineItems InvoiceLineItem[]
  receipt   Receipt?
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)
}

// Exactly one of sourceDepositInvoiceId/sourceInvoiceId must be set - enforced
// at the app level (see app/(app)/receipts/actions.ts) and backed by a DB
// CHECK constraint (num_nonnulls(...) = 1) added by hand in the
// 20260822131957_add_receipt migration, since this schema language has no
// native check-constraint attribute available here. Both FKs use
// onDelete: Restrict (not the usual SetNull for an optional source relation)
// specifically because SetNull would leave both columns null on delete,
// which the CHECK constraint forbids - Restrict fails the delete cleanly
// instead of hitting a raw constraint-violation error.
model Receipt {
  id                     String          @id @default(cuid())
  number                 String?         @unique
  year                   Int?
  date                   DateTime        @default(now())
  amount                 Decimal         @db.Decimal(12, 2)
  sourceDepositInvoiceId String?         @unique
  sourceDepositInvoice   DepositInvoice? @relation(fields: [sourceDepositInvoiceId], references: [id], onDelete: Restrict)
  sourceInvoiceId        String?         @unique
  sourceInvoice          Invoice?        @relation(fields: [sourceInvoiceId], references: [id], onDelete: Restrict)
  issuedAt               DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

// Per-type, per-year sequence for numbering (Q-2026-0001 etc.), incremented
// atomically in the same transaction that issues a document.
model DocumentCounter {
  id         String  @id @default(cuid())
  docType    DocType
  year       Int
  lastNumber Int     @default(0)

  @@unique([docType, year])
}
